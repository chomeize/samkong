{
  "name": "sam-kong",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @sam-kong/web",
    "start": "npm run start --workspace @sam-kong/server",
