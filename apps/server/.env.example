# Port the server listens on (Railway sets PORT automatically)
PORT=3001

# Only needed if the website is hosted on a different domain from this server.
# On Railway the server hosts the website itself, so leave this empty.
# Leave empty in development to allow any origin (phones on your Wi-Fi).
CORS_ORIGINS=

# Public URL of the web app (used in invite links sent by the server)
PUBLIC_WEB_URL=http://localhost:5173

# Behind a proxy, take client IPs from X-Forwarded-For (needed for fair rate limits).
# Defaults to true on Railway, false elsewhere.
TRUST_PROXY=

# Where the built website lives (defaults to apps/web/dist)
WEB_DIST_DIR=

# Limits
MAX_ROOMS=500
# Host is replaced after being offline this long (ms)
HOST_GRACE_MS=60000
# Room is deleted after nobody has been online this long (ms)
ROOM_IDLE_TTL_MS=1800000
# With Unlimited arrangement time, auto-submit a player offline this long (ms)
OFFLINE_AUTO_SUBMIT_MS=60000

# Only the site owner (who knows this key) can create rooms. Leave empty to let anyone create.
OWNER_KEY=

# Joining a room needs the host to allow each person (set to false to turn off)
JOIN_APPROVAL=true
